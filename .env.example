# ============================================
# VARIÁVEIS OBRIGATÓRIAS (REQUIRED)
# ============================================

# Database (Neon Postgres) - OBRIGATÓRIO
# Obtenha em: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# NextAuth Secret - OBRIGATÓRIO
# Gere com: openssl rand -base64 32
# NextAuth v5 usa AUTH_SECRET (recomendado)
# NEXTAUTH_SECRET também é aceito para compatibilidade
AUTH_SECRET=your_secret_key_here_generate_with_openssl_rand_base64_32

# NextAuth URL - OBRIGATÓRIO
# Em produção (Vercel): https://seu-dominio.vercel.app
# Em desenvolvimento: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ============================================
# AGENTE DE IA (OPTIONAL - habilita o chat com IA)
# ============================================

# OpenAI API Key - necessária para o agente de IA
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Modelo usado pelo agente (padrão: gpt-4o-mini)
AGENT_MODEL=gpt-4o-mini

# URL pública do servidor MCP (usado pela OpenAI para chamar as tools)
# Em produção: https://seu-dominio.vercel.app/api/mcp
# Em desenvolvimento: use ngrok ou similar para expor localhost
MCP_PUBLIC_URL=https://seu-dominio.vercel.app/api/mcp

# ============================================
# VARIÁVEIS OPCIONAIS (OPTIONAL)
# ============================================

# NEXTAUTH_SECRET - Opcional (use AUTH_SECRET em vez disso)
# Mantido apenas para compatibilidade com versões antigas
# NEXTAUTH_SECRET=your_secret_key_here_generate_with_openssl_rand_base64_32

# ============================================
# VARIÁVEIS ANTIGAS/DEPRECIADAS
# ============================================

# Stack Auth - NÃO MAIS USADO
# O projeto migrou para NextAuth v5
# Você pode remover estas variáveis se ainda as tiver configuradas:
# NEXT_PUBLIC_STACK_PROJECT_ID=...
# NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=...
# STACK_SECRET_SERVER_KEY=...
