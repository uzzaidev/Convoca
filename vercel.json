{
  "crons": [
    {
      "path": "/api/cron/generate-monthly-charges",
      "schedule": "0 6 1 * *"
    },
    {
      "path": "/api/cron/generate-recurring-events",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notify-event-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/notify-payment-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!CHANGELOG.md'"
}
