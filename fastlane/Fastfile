default_platform(:ios)

BUNDLE_ID = "com.uzzai.convoca"
TEAM_ID   = "2YRXNXGL8K"
# Nome do provisioning profile gerado pelo fastlane match
PROFILE_NAME = "match AppStore #{BUNDLE_ID}"

platform :ios do

  desc "Gerar e armazenar certificados (roda uma vez para setup)"
  lane :setup_certs do
    # Em CI nao existe keychain interativo — cria um temporario antes do match
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # Autentica no Apple Developer Portal via API Key (.p8), sem Apple ID/senha
    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    match(
      type:                    "appstore",
      readonly:                false,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    UI.success "Certificados gerados e salvos em convoca-certs ✅"
  end

  desc "Build e upload para TestFlight"
  lane :beta do
    # Keychain temporario para CI (sem keychain interativo no runner)
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # API Key para acesso ao Apple Developer Portal / App Store Connect
    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    # Instala Distribution Certificate + Provisioning Profile do repo convoca-certs
    match(
      type:                    "appstore",
      readonly:                true,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    # Muda o projeto para Manual Signing antes do archive.
    # Sem isso, o Xcode exige selecionar equipe na UI (falha em CI).
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "../../ios/App/App.xcodeproj",
      team_id:               TEAM_ID,
      bundle_identifier:     BUNDLE_ID,
      code_sign_identity:    "iPhone Distribution",
      profile_name:          PROFILE_NAME
    )

    # Build mobile (Next.js export → out/)
    sh("cd ../.. && pnpm build:mobile")

    # Sync Capacitor iOS (copia assets e plugins nativos)
    sh("cd ../.. && pnpm cap sync ios")

    # Instalar CocoaPods (dependencias nativas iOS)
    cocoapods(
      clean_install:    true,
      podfile:          "../../ios/App/Podfile",
      use_bundle_exec:  false
    )

    app_version = ENV["APP_VERSION"] || "1.0.0"
    build_num   = ENV["BUILD_NUMBER"] || "1"

    # Archive e exportar IPA
    gym(
      workspace:        "../../ios/App/App.xcworkspace",
      scheme:           "App",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "../../build",
      output_name:      "Convoca.ipa",
      # Passa team, versao e modo de signing explicitamente para o xcodebuild
      xcargs: [
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER=#{PROFILE_NAME}",
        "MARKETING_VERSION=#{app_version}",
        "CURRENT_PROJECT_VERSION=#{build_num}"
      ].join(" "),
      export_options: {
        method:               "app-store",
        teamID:               TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => PROFILE_NAME
        }
      }
    )

    # Upload para TestFlight via API Key (sem Apple ID / senha)
    pilot(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success "Upload para TestFlight concluído ✅ v#{app_version} (#{build_num})"
  end

end
