{
  "name": "convoca-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:doppler": "doppler run -- next dev --webpack",
    "build": "next build",
    "build:mobile": "node scripts/build-mobile-fallback.mjs",
    "build:mobile:web": "cross-env CAPACITOR_BUILD=true next build",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "cap sync",
    "cap:sync:ios": "cross-env CAPACITOR_PLATFORM=ios cap sync ios && node scripts/fix-ios-podfile-paths.mjs",
    "cap:sync:android": "cross-env CAPACITOR_PLATFORM=android cap sync android",
    "cap:copy": "cap copy",
    "cap:copy:ios": "cross-env CAPACITOR_PLATFORM=ios cap copy ios",
    "cap:copy:android": "cross-env CAPACITOR_PLATFORM=android cap copy android",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "cap run ios",
    "backup": "node scripts/backup-neon.mjs",
    "db:migrate": "node src/db/migrate.mjs",
    "db:status": "node src/db/migrate.mjs --status"
  },
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
