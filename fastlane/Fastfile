require "fileutils"

default_platform(:ios)

# __dir__ = pasta fastlane/ ; ROOT = raiz do repo
ROOT         = File.expand_path("..", __dir__)
BUNDLE_ID    = "com.uzzai.convoca"
TEAM_ID      = "2YRXNXGL8K"
PROFILE_NAME = "match AppStore #{BUNDLE_ID}"

platform :ios do

  # ---------------------------------------------------------------------------
  # setup_certs — roda UMA vez para gerar Distribution Cert + Provisioning Profile
  # ---------------------------------------------------------------------------
  desc "Gerar e armazenar certificados (roda uma vez para setup)"
  lane :setup_certs do
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    match(
      type:                    "appstore",
      readonly:                false,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    UI.success "Certificados gerados e salvos em convoca-certs ✅"
  end

  # ---------------------------------------------------------------------------
  # beta — build completo + upload para TestFlight
  # ---------------------------------------------------------------------------
  desc "Build e upload para TestFlight"
  lane :beta do

    # 1. Keychain temporario — CI nao tem keychain interativo
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    # 2. API Key Apple — autentica sem Apple ID/senha
    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    # 3. Instala Distribution Cert + Provisioning Profile do repo convoca-certs
    match(
      type:                    "appstore",
      readonly:                true,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    # 4. Muda o projeto para Manual Signing.
    #    update_code_signing_settings grava DEVELOPMENT_TEAM, CODE_SIGN_STYLE
    #    e PROVISIONING_PROFILE_SPECIFIER direto no .pbxproj — nao precisa
    #    repetir esses valores no xcargs do gym.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "#{ROOT}/ios/App/App.xcodeproj",
      team_id:               TEAM_ID,
      bundle_identifier:     BUNDLE_ID,
      code_sign_identity:    "iPhone Distribution",
      profile_name:          PROFILE_NAME
    )

    app_version = ENV["APP_VERSION"] || "1.0.0"
    build_num   = ENV["BUILD_NUMBER"] || "1"

    # 5. Gera out/ (Next.js export para Capacitor)
    sh("cd #{ROOT} && pnpm build:mobile")

    # 6. Copia assets e plugins nativos iOS.
    #    Usa "cap copy" (sem pod install) para evitar conflito de Ruby entre
    #    o setup-ruby 3.3 (nosso bundler) e o Homebrew Ruby 3.4 do runner.
    #    O pod install acontece no passo 7, usando diretamente o pod do sistema.
    sh("cd #{ROOT} && pnpm cap copy ios")

    # 7. Pod install e feito como step separado no workflow (ios-release.yml)
    #    ANTES de chamar "fastlane beta", para evitar o conflito de Ruby entre
    #    o bundle exec do fastlane (Ruby 3.3) e o CocoaPods do Homebrew (Ruby 3.4).
    #    O sh() herda o BUNDLE_GEMFILE/RUBYOPT do bundle exec e contamina o pod.

    # 8. Garante que a pasta de saida existe antes do gym
    FileUtils.mkdir_p("#{ROOT}/build")

    # 9. Archive + exportar IPA com Manual Signing.
    #    xcargs so passa versao — signing ja foi gravado no .pbxproj pelo passo 4.
    #    export_options define o metodo e mapeamento de provisioning profile.
    gym(
      workspace:        "#{ROOT}/ios/App/App.xcworkspace",
      scheme:           "App",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "#{ROOT}/build",
      output_name:      "Convoca.ipa",
      xcargs:           "MARKETING_VERSION=#{app_version} CURRENT_PROJECT_VERSION=#{build_num}",
      export_options: {
        method:               "app-store",
        teamID:               TEAM_ID,
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME }
      }
    )

    # 10. Upload para TestFlight (sem Apple ID, sem esperar processamento)
    pilot(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success "Upload para TestFlight concluído ✅ v#{app_version} (#{build_num})"
  end

end
