default_platform(:ios)

# __dir__ = pasta fastlane/; ROOT = raiz do repo
ROOT         = File.expand_path("..", __dir__)
BUNDLE_ID    = "com.uzzai.convoca"
TEAM_ID      = "2YRXNXGL8K"
PROFILE_NAME = "match AppStore #{BUNDLE_ID}"

platform :ios do

  desc "Gerar e armazenar certificados (roda uma vez para setup)"
  lane :setup_certs do
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    match(
      type:                    "appstore",
      readonly:                false,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    UI.success "Certificados gerados e salvos em convoca-certs ✅"
  end

  desc "Build e upload para TestFlight"
  lane :beta do
    # Keychain temporario para CI (sem keychain interativo no runner macOS)
    create_keychain(
      name:             "CI_KEYCHAIN",
      password:         ENV["MATCH_PASSWORD"],
      default_keychain: true,
      unlock:           true,
      timeout:          3600,
      lock_when_sleeps: false
    )

    api_key = app_store_connect_api_key(
      key_id:      ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id:   ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
      in_house:    false
    )

    # Instala Distribution Cert + Provisioning Profile do repo convoca-certs
    match(
      type:                    "appstore",
      readonly:                true,
      api_key:                 api_key,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      app_identifier:          BUNDLE_ID,
      team_id:                 TEAM_ID,
      keychain_name:           "CI_KEYCHAIN",
      keychain_password:       ENV["MATCH_PASSWORD"]
    )

    # Muda o projeto para Manual Signing.
    # Usa caminho absoluto para evitar ambiguidade de diretorio de trabalho.
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "#{ROOT}/ios/App/App.xcodeproj",
      team_id:               TEAM_ID,
      bundle_identifier:     BUNDLE_ID,
      code_sign_identity:    "iPhone Distribution",
      profile_name:          PROFILE_NAME
    )

    app_version = ENV["APP_VERSION"] || "1.0.0"
    build_num   = ENV["BUILD_NUMBER"] || "1"

    # Next.js export para Capacitor (gera out/)
    sh("cd #{ROOT} && pnpm build:mobile")

    # Copia assets e plugins nativos iOS (sem rodar pod install aqui).
    # "cap copy" evita o conflito de Ruby entre setup-ruby 3.3 e Homebrew 3.4
    # quando o Capacitor tentaria chamar "bundle exec pod" internamente.
    # O pod install e feito logo abaixo pelo action cocoapods do fastlane.
    sh("cd #{ROOT} && pnpm cap copy ios")

    # Instala dependencias nativas iOS via CocoaPods
    cocoapods(
      clean_install:   true,
      podfile:         "#{ROOT}/ios/App/Podfile",
      use_bundle_exec: false
    )

    # Archive + exportar IPA (Manual Signing)
    gym(
      workspace:        "#{ROOT}/ios/App/App.xcworkspace",
      scheme:           "App",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "#{ROOT}/build",
      output_name:      "Convoca.ipa",
      xcargs: [
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_STYLE=Manual",
        "PROVISIONING_PROFILE_SPECIFIER=#{PROFILE_NAME}",
        "MARKETING_VERSION=#{app_version}",
        "CURRENT_PROJECT_VERSION=#{build_num}"
      ].join(" "),
      export_options: {
        method:               "app-store",
        teamID:               TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => PROFILE_NAME
        }
      }
    )

    # Upload para TestFlight via API Key (sem Apple ID/senha)
    pilot(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true
    )

    UI.success "Upload para TestFlight concluído ✅ v#{app_version} (#{build_num})"
  end

end
